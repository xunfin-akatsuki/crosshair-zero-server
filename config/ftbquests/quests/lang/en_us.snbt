{
	chapter.1000000000000117.title: "第一章 · 活过今晚"
	chapter.100000000000011F.title: "第一章 · 活过今晚"
	chapter.1000000000000129.title: "第二章 · 扣下扳机"
	chapter.1000000000000131.title: "第二章 · 扣下扳机"
	chapter.1000000000000133.title: "第三章 · 第一条产线"
	chapter.100000000000013B.title: "第三章 · 第一条产线"
	chapter.100000000000013D.title: "第四章 · 钢铁皮肤"
	chapter.1000000000000145.title: "第四章 · 钢铁皮肤"
	chapter.1000000000000147.title: "第五章 · 炉心"
	chapter.100000000000014F.title: "第五章 · 炉心"
	chapter.1000000000000151.title: "第六章 · 十五眼"
	chapter.1000000000000159.title: "第六章 · 十五眼"
	chapter.1000000000000161.title: "第七章 · 缓冲区"
	chapter.1000000000000168.title: "支线 · 漫长的账本"
	chapter.1000000000000169.title: "第八章 · 1.7 秒"
	chapter.1000000000000170.title: "支线 · 漫长的账本"
	chapter.1000000000000172.title: "支线 · 废土收藏"
	chapter.100000000000017A.title: "支线 · 废土收藏"
	chapter.100000000000017B.title: "支线 · 零币与秩序"
	chapter.1000000000000182.title: "支线 · 重建度"
	chapter.1000000000000183.title: "支线 · 零币与秩序"
	chapter.100000000000018A.title: "支线 · 重建度"
	quest.1000000000000118.quest_desc: [
		"打开任务书（默认按键 ~ 或小键盘 0）。这是**重建者手册**：每完成一步，它亮下一步。"
		"第一阶段只有一个目标——活过今晚。暂时别靠近城市中心。"
		"包里已经放了一点东西：水、绷带、火把、温度计。先用起来，别舍不得。"
		"注意：前四天野外几乎不会有僵尸（首夜前不刷怪）。真正的压力是**渴、冷、负重**。"
	]
	quest.1000000000000118.quest_subtitle: "你在一座不肯安静死去的城市边缘醒来。没有伤口，没有记忆碎片的解释，只有一部还能开机的旧手机。\n城市还在，机器还在，路还在——唯独人没了。后来的人把这天叫作「零点」。"
	quest.1000000000000118.title: "零点之后"
	quest.1000000000000119.quest_desc: [
		"目标：获得 8 块原木。"
		"教学：本包有 Timber / Veinminer——按住对应键破坏树干可整棵伐倒。"
		"注意 eZWeight 负重：木头很重，别一次背太多，否则走路会变慢。"
	]
	quest.1000000000000119.quest_subtitle: "归零之后，第一件工具不是买来的，是从树上撕下来的。"
	quest.1000000000000119.title: "能砍的东西"
	quest.100000000000011A.quest_desc: [
		"目标：做出一把石镐。木棍 + 圆石，先做工作台。"
		"有了石镐，才能挖铁——铁是整条工业线的第一步。"
		"顺手给你一把石剑：这四天虽然没什么怪，但夜里有东西在远处看着。"
	]
	quest.100000000000011A.quest_subtitle: "石头不锋利，但它是所有锋利东西的起点。"
	quest.100000000000011A.title: "能握住的石头"
	quest.100000000000011B.quest_desc: [
		"目标：做出 16 支火把。煤炭 + 木棍；煤炭也能在篝火上烧木头得到。"
		"火把同时是热源——夜晚低温会持续掉体温（LSO 生存系统）。"
		"补给：多给一份煤炭，让你不必为燃料专门下矿。"
	]
	quest.100000000000011B.quest_subtitle: "黑暗里有东西在动。火把不说话，但它会让那些东西犹豫。"
	quest.100000000000011B.title: "火与光"
	quest.100000000000011C.quest_desc: [
		"目标：放下并睡过一次床。三块羊毛 + 三块木板。"
		"床 = 重生点。死了会掉部分物品，但床能让你回来。"
		"补给里有一条**保暖线**：它是 LSO 保暖装备的升级件，夜里很有用。"
	]
	quest.100000000000011C.quest_subtitle: "你不需要一座房子，你需要一个能闭眼的地方。"
	quest.100000000000011C.title: "今晚的屋顶"
	quest.100000000000011D.quest_desc: [
		"目标：放下一个箱子并存入至少一件物资。"
		"Lootr 让多人各自独立开箱，不用担心被抢。"
		"补给：一个**铜背包**。eZWeight 会算背包里的重量——但装得下总比手拿强。"
	]
	quest.100000000000011D.quest_subtitle: "箱子是重建者的第一个命令：这里的东西，归这里。"
	quest.100000000000011D.title: "不会腐坏的东西"
	quest.100000000000011E.quest_desc: [
		"目标：打开背包界面，看清当前负重。"
		"eZWeight 上限约 **100kg**：一把重枪 + 一套甲 + 弹药就占掉大半。"
		"带什么出门是一个真决策，不是收集游戏。"
		"补给：起步扩容升级，让你的第一次远行不用二选一。"
	]
	quest.100000000000011E.quest_subtitle: "重建者的第一条纪律：你只能带走你背得动的东西。"
	quest.100000000000011E.title: "你背得动多少"
	quest.100000000000011F.quest_desc: [
		"目标：放置一台**收购箱**（ShippingBin）。"
		"它什么都收，价格是基准价的 0.60——便宜，但不挑。村民价格更高，可只收本职业相关。"
		"补给里放了铁锭和皮革：**马上就能拿去卖**，先熟悉这条链。"
	]
	quest.100000000000011F.quest_subtitle: "归零之后没人认得旧钞票。人们需要一种所有人都承认的交换物。"
	quest.100000000000011F.title: "回收站"
	quest.1000000000000120.quest_desc: [
		"打开任务书（默认按键 ~ 或小键盘 0）。这是**重建者手册**：每完成一步，它亮下一步。"
		"口袋里有一部还能开机的旧手机——它是你的阅读器、相机、地图和购物终端。"
		"手边还有一套**捡来的旧装备**：一件背心、一块插板、一顶头盔，以及一把手枪和一把霰弹枪，配着不多的弹。它们不新，但能让你活着走进城区。"
		"另外给了水、绷带、火把、温度计和一点吃的。先用起来，别舍不得。"
		"注意：前四天野外几乎不会有僵尸（首夜前不刷怪）。真正的压力是**渴、冷、负重**，以及城里的**人**。"
	]
	quest.1000000000000120.quest_subtitle: "你在一座不肯安静死去的城市边缘醒来。没有伤口，没有记忆碎片的解释，只有一部还能开机的旧手机。\n城市还在，机器还在，路还在——唯独人没了。后来的人把这天叫作「零点」。"
	quest.1000000000000120.title: "零点之后"
	quest.1000000000000121.quest_desc: [
		"目标：获得 8 块原木。"
		"教学：本包有 Timber / Veinminer——按住对应键破坏树干可整棵伐倒。"
		"注意 eZWeight 负重：木头很重，别一次背太多，否则走路会变慢。"
	]
	quest.1000000000000121.quest_subtitle: "归零之后，第一件工具不是买来的，是从树上撕下来的。"
	quest.1000000000000121.title: "能砍的东西"
	quest.1000000000000122.quest_desc: [
		"目标：做出一把石镐。木棍 + 圆石，先做工作台。"
		"有了石镐，才能挖铁——铁是整条工业线的第一步。"
		"顺手给你一把石剑：这四天虽然没什么怪，但夜里有东西在远处看着。"
	]
	quest.1000000000000122.quest_subtitle: "石头不锋利，但它是所有锋利东西的起点。"
	quest.1000000000000122.title: "能握住的石头"
	quest.1000000000000123.quest_desc: [
		"目标：做出 16 支火把。煤炭 + 木棍；煤炭也能在篝火上烧木头得到。"
		"火把同时是热源——夜晚低温会持续掉体温（LSO 生存系统）。"
		"补给：多给一份煤炭，让你不必为燃料专门下矿。"
	]
	quest.1000000000000123.quest_subtitle: "黑暗里有东西在动。火把不说话，但它会让那些东西犹豫。"
	quest.1000000000000123.title: "火与光"
	quest.1000000000000124.quest_desc: [
		"目标：放下并睡过一次床。三块羊毛 + 三块木板。"
		"床 = 重生点。死了会掉部分物品，但床能让你回来。"
		"补给里有一条**保暖线**：它是 LSO 保暖装备的升级件，夜里很有用。"
	]
	quest.1000000000000124.quest_subtitle: "你不需要一座房子，你需要一个能闭眼的地方。"
	quest.1000000000000124.title: "今晚的屋顶"
	quest.1000000000000125.quest_desc: [
		"目标：放下一个箱子并存入至少一件物资。"
		"Lootr 让多人各自独立开箱，不用担心被抢。"
		"补给：一个**铜背包**。eZWeight 会算背包里的重量——但装得下总比手拿强。"
	]
	quest.1000000000000125.quest_subtitle: "箱子是重建者的第一个命令：这里的东西，归这里。"
	quest.1000000000000125.title: "不会腐坏的东西"
	quest.1000000000000126.quest_desc: [
		"目标：打开背包界面，看清当前负重。"
		"eZWeight 上限约 **100kg**：一把重枪 + 一套甲 + 弹药就占掉大半。"
		"带什么出门是一个真决策，不是收集游戏。"
		"补给：起步扩容升级，让你的第一次远行不用二选一。"
	]
	quest.1000000000000126.quest_subtitle: "重建者的第一条纪律：你只能带走你背得动的东西。"
	quest.1000000000000126.title: "你背得动多少"
	quest.1000000000000127.quest_desc: [
		"目标：放置一台**收购箱**（ShippingBin）。"
		"它什么都收，价格是基准价的 0.60——便宜，但不挑。村民价格更高，可只收本职业相关。"
		"补给里放了铁锭和皮革：**马上就能拿去卖**，先熟悉这条链。"
	]
	quest.1000000000000127.quest_subtitle: "归零之后没人认得旧钞票。人们需要一种所有人都承认的交换物。"
	quest.1000000000000127.title: "回收站"
	quest.1000000000000128.quest_desc: [
		"目标：在收购箱里卖东西，赚到第一笔零币。"
		"零币（Numismatic）是这个世界上唯一还被所有人承认的东西。"
		"补给：一件**1 级加热外套**——夜里失温是早期最常见的死法。"
	]
	quest.1000000000000128.quest_subtitle: "把捡来的东西换成钱，是把「偶然」变成「可持续」。"
	quest.1000000000000128.title: "第一笔零币"
	quest.1000000000000129.quest_desc: [
		"目标：持有 100 枚零币。"
		"零币**既是钱也是材料**——攒着买枪，还是熔了做弹药，是这个世界的核心抉择。"
		"补给：一只**水壶**。有了容器，你才敢走出半天脚程。"
	]
	quest.1000000000000129.quest_subtitle: "别把它当成钱。它是一块能把人烧化的东西，只是大家都同意用它来算账。"
	quest.1000000000000129.title: "零点币"
	quest.100000000000012A.quest_desc: [
		"目标：用手机（MCphone）的**阅读器**读完一份废墟里的档案。"
		"档案会转化为「阅历点」，用来解锁顿悟（Epiphany）。"
		"它还能拍照标记路线，以及——**零点购物**（下一节讲）。"
		"补给：够你下第一单的零币，加上两份绷带和草药。"
	]
	quest.100000000000012A.quest_subtitle: "归零后最实用的东西是手机：阅读器、相机、通讯、地图。它不是娱乐设备。"
	quest.100000000000012A.title: "还能开机的那部"
	quest.100000000000012B.quest_desc: [
		"目标：放置一个**邮筒**（Contact）并绑定。"
		"**没有邮筒就收不到网购的包裹**——这是零点购物的唯一收货方式。"
		"补给：包装纸、信封，以及两份滋补剂。"
	]
	quest.100000000000012B.quest_subtitle: "邮件在归零那天停了一半。剩下的那一半，还在投。"
	quest.100000000000012B.title: "门口那个铁盒子"
	quest.100000000000012C.quest_desc: [
		"目标：用 MCphone 的**零点购物**下单一次。"
		"规则：**下单当日不发货，次日送达**；信箱满了会排队，不重复扣款。"
		"供应商价格高于收购箱、低于村民零售——它是\"省时间\"，不是\"省钱\"。"
		"补给：一套**铁制工具**，让你少花一整天挖矿。"
	]
	quest.100000000000012C.quest_subtitle: "有些东西不用亲自去废墟里翻——只要你出得起价，明天就有人送到信箱。"
	quest.100000000000012C.title: "第一次邮购"
	quest.100000000000012D.quest_desc: [
		"目标：造出熔炉并烤熟一份肉。圆石 ×8 → 熔炉；燃料用煤炭或木头。"
		"本包食物恢复量偏高（农业模组加持），但生肉会带来不适。"
		"补给：几块生牛肉，正好继续烤。"
	]
	quest.100000000000012D.quest_subtitle: "冷的东西只能让你不饿，热的东西能让你不那么怕。"
	quest.100000000000012D.title: "热的食物"
	quest.100000000000012E.quest_desc: [
		"目标：做一个铁桶。渴（LSO）掉得比饿快得多。"
		"野外水不干净，直接喝会出问题。"
		"补给：一台**净水器**——把脏水变成能喝的水，比反复烧水省事。"
	]
	quest.100000000000012E.quest_subtitle: "归零之后，最贵的不是子弹，是能直接喝下去的东西。"
	quest.100000000000012E.title: "一杯干净的水"
	quest.100000000000012F.quest_desc: [
		"认识感染机制（Contagion）：被感染者攻击有 **50% 概率感染**；"
		"穿甲可降低概率（满下界合金甲约减 60%）；感染持续 600 tick，期间随机出现症状。"
		"**牛奶无效**。解除方式：**金苹果 / 附魔金苹果**，或治愈药水（`contagion:cure_potion`）。"
		"被感染的村民会转化成僵尸。"
		"补给：两个金苹果 + 一瓶**治愈药水**——第一次中招时不会手足无措。"
	]
	quest.100000000000012F.quest_subtitle: "城里有一种东西，咬伤不只是掉血。**感染**会在几分钟后开始计时。"
	quest.100000000000012F.title: "别让它咬到你"
	quest.1000000000000130.quest_desc: [
		"确认活过第一个夜晚。"
		"**从第 5 天起会来第一次尸潮**（每 5 天一次，100% 触发，尸潮夜不能睡）——详见第二章。"
		"在剩下来的几天里，把据点围起来、备好弹药、找一把枪。"
		"补给：一套过渡装备，够你撑到第一次尸潮。"
	]
	quest.1000000000000130.quest_subtitle: "你把水、火、食物、一张床、一台收购箱和一部手机凑齐了。\n在归零后的世界里，这已经是一个人很了不起的成就。"
	quest.1000000000000130.title: "活过今晚"
	quest.1000000000000131.quest_desc: [
		"目标：在一次交火中成功脱离（撤出战斗）。"
		"教学：ParCool 有翻滚与爬墙；按对应键可快速位移。"
		"打不过就跑。装备可以再捡，命不能。"
	]
	quest.1000000000000131.quest_subtitle: "重建者活得久，是因为知道哪一仗不该打。"
	quest.1000000000000131.title: "逃不是耻辱"
	quest.1000000000000132.quest_desc: [
		"目标：确认你已离开出生点周边，进入废车场区域。"
		"教学：废弃车辆是第一批枪械来源。"
		"注意：郊区弹药箱（suburbanammo）也会有子弹，但量不多。"
	]
	quest.1000000000000132.quest_subtitle: "高速路残骸里停着成百上千辆车。归零那天，车钥匙还在点火孔里。"
	quest.1000000000000132.title: "废车场的规矩"
	quest.1000000000000133.quest_desc: [
		"目标：获得任意一把手枪（TaCZ 或 SBW 均可）。"
		"教学：搜「废弃车辆」战利品表。也可以撬开街边的技术皮卡。"
		"本包两套枪械系统：TaCZ（联邦制式）与 Superb Warfare（军阀自制）。"
	]
	quest.1000000000000133.quest_subtitle: "枪不难找。难的是——它里面的子弹不会自己变多。"
	quest.1000000000000133.title: "第一把枪"
	quest.1000000000000134.quest_desc: [
		"目标：凑够 30 发手枪弹。"
		"教学：SBW 弹药是独立物品（如 9mm / .45 ACP）；TaCZ 弹药是通用物品带型号。"
		"前期靠捡。中后期要靠自己的产线（第三章）。"
	]
	quest.1000000000000134.quest_subtitle: "你可以把枪挂在墙上当装饰品。真要用它，你得有弹。"
	quest.1000000000000134.title: "子弹比枪贵"
	quest.1000000000000135.quest_desc: [
		"目标：开过至少一枪。"
		"教学：TaCZ 默认 R 装填，左键开火；SBW 键位在设置里可查。"
		"枪声会吸引附近敌人（SoundAttract）。开完枪就该换位置。"
	]
	quest.1000000000000135.quest_subtitle: "第一声枪响之后，你在别人的耳朵里就不再是背景音了。"
	quest.1000000000000135.title: "压弹、上膛、开火"
	quest.1000000000000136.quest_desc: [
		"目标：击杀 15 个敌对生物。"
		"教学：按 Q 键可快速切枪；蹲下（Shift）可显著提升精度。"
		"护甲在早期比枪重要——见下一步。"
	]
	quest.1000000000000136.quest_subtitle: "子弹打断骨头。保持移动，贴墙，别在空地上找人。"
	quest.1000000000000136.title: "别站着不动"
	quest.1000000000000137.quest_desc: [
		"目标：获得 4 块钢板或护甲板。"
		"教学：zerocontact 是防护体系：背心 + 插板 + 头盔三件套。"
		"插板防正面，重板保命、轻板保速——eZWeight 下这是真取舍。"
	]
	quest.1000000000000137.quest_subtitle: "拾荒者的第一块插板通常是从别人的背心上拆下来的。"
	quest.1000000000000137.title: "第一块钢板"
	quest.1000000000000138.quest_desc: [
		"目标：进入一次城市中心建筑（消防站 / 医院 / 超市）。"
		"教学：消防站出武器与防护服；医院出医疗品；超市出杂货。"
		"城市里怪物更密集，还可能出现武装土匪。"
	]
	quest.1000000000000138.quest_subtitle: "灰市是完整城市的废墟。那里什么都有——也什么都想要你的命。"
	quest.1000000000000138.title: "第一次进城"
	quest.1000000000000139.quest_desc: [
		"目标：在一次交火中成功脱离（撤出战斗）。"
		"教学：ParCool 有翻滚与爬墙；按对应键可快速位移。"
		"打不过就跑。装备可以再捡，命不能。"
	]
	quest.1000000000000139.quest_subtitle: "重建者活得久，是因为知道哪一仗不该打。"
	quest.1000000000000139.title: "逃不是耻辱"
	quest.100000000000013A.quest_desc: [
		"目标：确认完成第二章。"
		"教学：下一章你将学会自己造子弹。"
		"那是「幸存者」和「重建者」的分界线。"
	]
	quest.100000000000013A.quest_subtitle: "你现在有枪、有弹、有一块钢板。\n这是归零后第一次——你能主动决定谁活着。"
	quest.100000000000013A.title: "有枪的人"
	quest.100000000000013B.quest_desc: [
		"目标：库存中同时持有两种口径的弹药各 60 发。"
		"教学：口径对应敌人：9mm 打人，5.56 打常规，.308 打变异体，.50 BMG 打载具。"
	]
	quest.100000000000013B.quest_subtitle: "5.56 能打，7.62 更狠，.308 靠得远。选哪个，取决于你要去打谁。"
	quest.100000000000013B.title: "口径的阶梯"
	quest.100000000000013C.quest_desc: [
		"目标：理解本阶段的核心——把产能从「捡」换成「造」。"
		"教学：本章围绕 Create 机械与弹药生产线展开。"
	]
	quest.100000000000013C.quest_subtitle: "捡东西的人只能活到废墟被搜完的那天。\n造东西的人，可以一直活下去。"
	quest.100000000000013C.title: "不再依赖废墟"
	quest.100000000000013D.quest_desc: [
		"目标：获得 16 个安山合金。"
		"教学：需要锌矿（Create）。锌在 Y=30 以下。"
		"安山合金是整套动力系统的骨架。"
	]
	quest.100000000000013D.quest_subtitle: "Create 的第一步永远一样：安山岩 + 铁 + 锌，合成安山合金。"
	quest.100000000000013D.title: "安山合金"
	quest.100000000000013E.quest_desc: [
		"目标：放置水车或风车，并用传动轴输出动力。"
		"教学：风车 → 大齿轮 → 传动轴 → 石磨。转速不要过低，否则机器不工作。"
	]
	quest.100000000000013E.quest_subtitle: "归零让所有机器停转。你要做的第一件事，是让一根轴重新转起来。"
	quest.100000000000013E.title: "转起来"
	quest.100000000000013F.quest_desc: [
		"目标：获得 12 个黄铜锭。"
		"教学：铜 + 锌在混合器中熔炼，或用鼓风机加热搅拌。"
		"黄铜零件（精密机构）需要序列装配。"
	]
	quest.100000000000013F.quest_subtitle: "黄铜是 Create 的关节。它比铁软，比铁听话。"
	quest.100000000000013F.title: "黄铜的时代"
	quest.1000000000000140.quest_desc: [
		"目标：收集弹药制造的原料（tacz_c 弹药零件）。"
		"教学：tacz_c 提供弹壳、火药、弹头等零件，是本包的弹药产线基础。"
		"这些零件不进战利品表——必须自己造或拆解。"
	]
	quest.1000000000000140.quest_subtitle: "一颗子弹的组成，一百年没变过：壳、底火、药、头。"
	quest.1000000000000140.title: "壳与头"
	quest.1000000000000141.quest_desc: [
		"目标：用冲压机产出至少 64 个弹壳。"
		"教学：Create 的「冲压机」（Mechanical Press）配合模具。"
		"口径越大，工序越多——.50 BMG 一条线上五道工序，才配得上它的威力。"
	]
	quest.1000000000000141.quest_subtitle: "铜板卷成壳，一颗一颗压出来。"
	quest.1000000000000141.title: "冲压"
	quest.1000000000000142.quest_desc: [
		"目标：产出一条能稳定产出 5.56 或 7.62×39 的弹药线。"
		"教学：壳 → 底火 → 火药 → 弹头 → 成品，用传送带或漏斗串起来。"
		"产能不用大，稳定就够了。"
	]
	quest.1000000000000142.quest_subtitle: "从这一刻起，你不再靠别人施舍弹药。"
	quest.1000000000000142.title: "第一条产线"
	quest.1000000000000143.quest_desc: [
		"目标：库存中同时持有两种口径的弹药各 60 发。"
		"教学：口径对应敌人：9mm 打人，5.56 打常规，.308 打变异体，.50 BMG 打载具。"
	]
	quest.1000000000000143.quest_subtitle: "5.56 能打，7.62 更狠，.308 靠得远。选哪个，取决于你要去打谁。"
	quest.1000000000000143.title: "口径的阶梯"
	quest.1000000000000144.quest_desc: [
		"目标：确认完成第三章。"
		"教学：下一阶段是把产能变成「能保护一群人」的力量。"
		"零币（Numismatic）此时该开始有结余了，可以去村民或供应商那里交易。"
	]
	quest.1000000000000144.quest_subtitle: "你造出了第一件废墟里没有的东西。\n这不是捡来的文明残渣——这是你自己的。"
	quest.1000000000000144.title: "重建者"
	quest.1000000000000145.quest_desc: [
		"目标：打开手机（MCphone）的阅读器，读完至少 3 份情报档案。"
		"教学：情报书会转化为「阅历点 / Insight Points」，用于解锁顿悟（Epiphany）。"
		"顿悟是本包的能力树：从观察、理解、生存、重建四条路径展开。"
	]
	quest.1000000000000145.quest_subtitle: "你读懂了废墟里留下的东西。\n这不是知识的积累，是某一瞬间——你想通了。"
	quest.1000000000000145.title: "第一次顿悟"
	quest.1000000000000146.quest_desc: [
		"目标：开始搜集防护装备。"
		"教学：zerocontact 提供背心 / 头盔 / 插板；插板决定能挡什么弹。"
	]
	quest.1000000000000146.quest_subtitle: "变异体的血是热的，但它们不在乎疼。\n你要么挡住它们的爪子，要么学会跑得比它们快。"
	quest.1000000000000146.title: "会流血的东西"
	quest.1000000000000147.quest_desc: [
		"目标：穿上一件防弹背心。"
		"教学：zerocontact 背心 + 插板。不同背心支持的板位不同。"
		"注意负重：重板 + 弹药 + 枪，很容易超 100kg。"
	]
	quest.1000000000000147.quest_subtitle: "一件防弹背心本身挡不住什么。真正挡子弹的是插进去的那块板。"
	quest.1000000000000147.title: "背心与插板"
	quest.1000000000000148.quest_desc: [
		"目标：获得并装备钢板插板。"
		"教学：zerocontact:plate_steel。更高档还有陶瓷 / 复合板。"
		"插板有耐久，被打多了会碎（用 repair kit 修）。"
	]
	quest.1000000000000148.quest_subtitle: "钢板的用处不在于让你不死，而在于让你多撑三秒。"
	quest.1000000000000148.title: "挡住它"
	quest.1000000000000149.quest_desc: [
		"目标：凑齐一套医疗物资。"
		"教学：LSO 提供绷带 / 医疗包 / 吗啡。医院与救护车是主要来源。"
		"别用医疗包治擦伤。把资源留给真正的伤口。"
	]
	quest.1000000000000149.quest_subtitle: "归零后的医院是最值钱的地方，也是最容易死的地方。"
	quest.1000000000000149.title: "医学不是奢侈品"
	quest.100000000000014A.quest_desc: [
		"目标：搭建至少一条自动化传送 / 存储链。"
		"教学：Create 的传送带、漏斗、溜槽、机械臂。"
		"Sophisticated Storage 能做成网络化仓库，比箱子省地方。"
	]
	quest.100000000000014A.quest_subtitle: "让机器替你搬运，你才有时间去更远的地方。"
	quest.100000000000014A.title: "自动化不是炫技"
	quest.100000000000014B.quest_desc: [
		"目标：获得一把 DMR 或栓动狙击枪。"
		"教学：4 星档（Kar98 / M700 / SKS）已足够应付变异体。"
		"精确射击需要配件（瞄具 / 稳定性枪托）。"
	]
	quest.100000000000014B.quest_subtitle: "当你开始打硬东西，你会想要一把能打穿它的枪。"
	quest.100000000000014B.title: "更远的枪"
	quest.100000000000014C.quest_desc: [
		"目标：构筑掩体 / 围墙，并在据点内度过一夜且无人死亡。"
		"教学：MineTraps 提供陷阱；sandbag 与铁栅栏提供掩体。"
		"有守卫村民（Guard Villagers）后可以让他们驻扎。"
	]
	quest.100000000000014C.quest_subtitle: "据点不是一堆箱子。据点是你不在的时候，别人也进不来的地方。"
	quest.100000000000014C.title: "守住一夜"
	quest.100000000000014D.quest_desc: [
		"目标：打开手机（MCphone）的阅读器，读完至少 3 份情报档案。"
		"教学：情报书会转化为「阅历点 / Insight Points」，用于解锁顿悟（Epiphany）。"
		"顿悟是本包的能力树：从观察、理解、生存、重建四条路径展开。"
	]
	quest.100000000000014D.quest_subtitle: "你读懂了废墟里留下的东西。\n这不是知识的积累，是某一瞬间——你想通了。"
	quest.100000000000014D.title: "第一次顿悟"
	quest.100000000000014E.quest_desc: [
		"目标：确认完成第四章。"
		"教学：下一章你将离开表层世界，进入「地基」。"
		"准备温控义体或抗火药——下界会把你烤化。"
	]
	quest.100000000000014E.quest_subtitle: "你不再是一个人活着了。\n你的据点开始像一个「地方」，而不是一个藏身点。"
	quest.100000000000014E.title: "能保护一群人"
	quest.100000000000014F.quest_desc: [
		"目标：穿越扭曲森林并安全返回。"
		"教学：薄区里传送异常，落点会漂移。"
		"Warped Mosco 在这一带活动，飞行 + 孢子攻击。"
	]
	quest.100000000000014F.quest_subtitle: "扭曲森林里的空间比别处薄。你走三步，可能会出现在第五步的位置。"
	quest.100000000000014F.title: "薄区"
	quest.1000000000000150.quest_desc: [
		"目标：在管制区找到通往地基的入口（废弃传送门 / 竖井）。"
		"教学：下界是阶段 5 的主要战场，也是灵魂材料与熔岩核的唯一来源。"
	]
	quest.1000000000000150.quest_subtitle: "主世界是被清空的城。城市下面，是一台还没关掉的机器。\n零点计划在这里抽热、烧数据——它不叫地狱，它叫地基。"
	quest.1000000000000150.title: "地基"
	quest.1000000000000151.quest_desc: [
		"目标：进入下界。"
		"教学：LSO 的温度系统在下界会持续高温伤害，必须准备抗性手段。"
		"温控义体（CyberWare）或抗火药水都能解决。"
	]
	quest.1000000000000151.quest_subtitle: "温度是第一个敌人。这里的热不打算杀死你——它只是不打算放过你。"
	quest.1000000000000151.title: "踏进炉心"
	quest.1000000000000152.quest_desc: [
		"目标：准备至少一种持续抗热手段。"
		"教学：抗火药水（1:30）、温控义体、或金苹果 + 抗性。"
		"没有抗热就别打 Boss——你会死于环境而不是敌人。"
	]
	quest.1000000000000152.quest_subtitle: "皮革和布没用。你需要能承受岩浆的东西。"
	quest.1000000000000152.title: "抗热"
	quest.1000000000000153.quest_desc: [
		"目标：击杀骨蛇。"
		"教学：骨蛇两段——钻地后跃出。它跃出的瞬间是你唯一稳定的输出窗口。"
		"掉落骨蛇牙，可做破甲近战强化件。"
	]
	quest.1000000000000153.quest_subtitle: "玄古岩柱之间，有条东西在钻。它不追你——它在等你走过它头顶。"
	quest.1000000000000153.title: "骨蛇"
	quest.1000000000000154.quest_desc: [
		"目标：击杀熔岩巨兽（Laviathan）。"
		"教学：战场是岩浆，不是水。带抗火、带远程。"
		"它会把你拽进岩浆——保持距离。"
	]
	quest.1000000000000154.quest_subtitle: "冷却回路还在空转。有东西在岩浆里长大了，它以为自己还是这台机器的一部分。"
	quest.1000000000000154.title: "熔岩巨兽"
	quest.1000000000000155.quest_desc: [
		"目标：进入下界要塞，取得一份炉心记录。"
		"教学：这是「1.7 秒」三份记录之一。"
		"要塞砖档里也有铅、钨、钢等高级材料。"
	]
	quest.1000000000000155.quest_subtitle: "要塞是零点计划的变电站与值班宿舍。值班的人走了，值班记录还在。"
	quest.1000000000000155.title: "要塞变电站"
	quest.1000000000000156.quest_desc: [
		"目标：获得下界之眼（endrem:nether_eye）。"
		"教学：十五眼中有一只在下界。集齐十五只是第六章的目标。"
	]
	quest.1000000000000156.quest_subtitle: "眼不会自己看着你。它只是被摆在那里，记录它看到过的东西。"
	quest.1000000000000156.title: "炉心的眼"
	quest.1000000000000157.quest_desc: [
		"目标：穿越扭曲森林并安全返回。"
		"教学：薄区里传送异常，落点会漂移。"
		"Warped Mosco 在这一带活动，飞行 + 孢子攻击。"
	]
	quest.1000000000000157.quest_subtitle: "扭曲森林里的空间比别处薄。你走三步，可能会出现在第五步的位置。"
	quest.1000000000000157.title: "薄区"
	quest.1000000000000158.quest_desc: [
		"目标：确认完成第五章。"
		"教学：下一章要集齐十五只眼，那是打开末地的钥匙。"
		"建议先把下界的材料带回主世界储存。"
	]
	quest.1000000000000158.quest_subtitle: "你从地基里带回了东西：材料、记录、和一点关于那 1.7 秒的线索。"
	quest.1000000000000158.title: "上面是被清空的城，下面是还在烧的炉"
	quest.100000000000015A.quest_desc: [
		"目标：集齐十五只眼（endrem）。"
		"教学：每只眼来源不同——Boss、遗迹、生态、解密。"
		"本章分五段，按线索分类。"
	]
	quest.100000000000015A.quest_subtitle: "归零前的观测设备都记录过同一件事，但只有零点的观测站把记录留了下来。\n十五只眼散落在世界各处——它们是打开那座站的钥匙。"
	quest.100000000000015A.title: "第十五只眼睛"
	quest.100000000000015B.quest_desc: [
		"目标：集齐 Old Eye、Rogue Eye、Cold Eye。"
		"教学：旧眼在沙漠遗迹；流浪者之眼在废车场；寒眼在雪原 / 极地。"
	]
	quest.100000000000015B.quest_subtitle: "传说里，旧眼属于某只巨大的沙虫；寒眼来自没人回来的极地。"
	quest.100000000000015B.title: "沙与寒"
	quest.100000000000015C.quest_desc: [
		"目标：集齐 Lost Eye、Wither Eye、Guardian Eye。"
		"教学：凋灵之眼需要打凋灵（用凋灵祭坛）；守卫者之眼在海底神殿。"
	]
	quest.100000000000015C.quest_subtitle: "炉心带回了下界之眼。其余的，藏在再也点不着火的锻炉里。"
	quest.100000000000015C.title: "火与铁"
	quest.100000000000015D.quest_desc: [
		"目标：集齐 Magical Eye、Cursed Eye、Witch Eye。"
		"教学：魔法之眼来自唤魔师；诅咒之眼来自女巫集落。"
	]
	quest.100000000000015D.quest_subtitle: "有些东西在归零那天活了下来——它们本来就不算活物。"
	quest.100000000000015D.title: "咒与术"
	quest.100000000000015E.quest_desc: [
		"目标：集齐 Undead Eye、Black Eye。"
		"教学：亡灵之眼来自夜潮 / 变异体；黑珍珠之眼来自沉船与幽灵船长。"
	]
	quest.100000000000015E.quest_subtitle: "死亡不是唯一的结局。归零之后，有些东西以「还在动」的状态留了下来。"
	quest.100000000000015E.title: "亡者与深海"
	quest.100000000000015F.quest_desc: [
		"目标：集齐 Exotic Eye、Evil Eye、Cryptic Eye、Corrupted Eye。"
		"教学：隐语之眼需要解开加密终端（Clavis）；破损之眼在缓冲区 / 零号区。"
	]
	quest.100000000000015F.quest_subtitle: "还有几只眼，不属于任何常识里的地方。"
	quest.100000000000015F.title: "异域与隐语"
	quest.1000000000000160.quest_desc: [
		"目标：确认十五只眼全部到手。"
		"教学：把它们放进古代传送门框架（Ancient Portal Frame）。"
		"门后是「缓冲区」——零点事件在模拟层里留下的另一面。"
	]
	quest.1000000000000160.quest_subtitle: "十五只眼摆上去的那一刻，门会自己知道该怎么开。"
	quest.1000000000000160.title: "门的钥匙"
	quest.1000000000000162.quest_desc: [
		"目标：通过门进入末地。"
		"教学：末地地形破碎，虚空掉落即死，务必带缓降与位移手段。"
	]
	quest.1000000000000162.quest_subtitle: "主世界是被重置的档案，下界是烧档案的炉，末地是还没写完的备份。\n这里几乎没有东西——所以留下来的，都是最硬的。"
	quest.1000000000000162.title: "没写完的备份"
	quest.1000000000000163.quest_desc: [
		"目标：抵达一座末地城并搜刮。"
		"教学：末地城是远古 CPU、狗牌、观测蓝图最密集的地方——也是 5–6 星战利品区。"
	]
	quest.1000000000000163.quest_subtitle: "末地城不是城市，是中继站。归零前，这里的仪器还在往外发信号。"
	quest.1000000000000163.title: "观测站"
	quest.1000000000000164.quest_desc: [
		"目标：击杀 3 只变异末影人。"
		"教学：变异末影人会瞬移并召唤分身（Endersoul）。用范围武器或高射速压制。"
	]
	quest.1000000000000164.quest_subtitle: "末影人不是新的物种。它们是归零了一半的搬运体，还在执行「取送」指令。"
	quest.1000000000000164.title: "半归零的人"
	quest.1000000000000165.quest_desc: [
		"目标：击杀末影龙。"
		"教学：本包使用强化龙战（DragonFight）——多阶段，必须先清水晶。"
		"建议：全队毕业装备 + 缓降 + 远程。"
	]
	quest.1000000000000165.quest_subtitle: "龙不是生物，是缓冲区的看门进程。它不让外人把缓存读干净。"
	quest.1000000000000165.title: "看门进程"
	quest.1000000000000166.quest_desc: [
		"目标：用图腾召唤并击杀虚空蠕虫。"
		"教学：先取得虚空蠕虫图腾（Void Worm Effigy），放置后召唤。"
		"战斗中会被空间拉扯，坠入虚空即死。打它的眼部。"
	]
	quest.1000000000000166.quest_subtitle: "龙倒了，缓存才允许把里面的东西拉出来。\n虚空蠕虫不是「遇上的」——它是被召出来的。"
	quest.1000000000000166.title: "缓存里的增生体"
	quest.1000000000000167.quest_desc: [
		"目标：取得第二份记录（远古 CPU）。"
		"教学：这是「1.7 秒」三份记录的第二份。"
		"第三份在零号区。"
	]
	quest.1000000000000167.quest_subtitle: "观测站的数据还在。它记录了零点当天，从缓冲区的角度看到的东西。"
	quest.1000000000000167.title: "记录之二"
	quest.1000000000000168.quest_desc: [
		"目标：确认完成第七章。"
		"教学：三份记录齐了之后，就能拼出时间线。"
		"准备终局：重火力、义体、满编弹药。"
	]
	quest.1000000000000168.quest_subtitle: "你在缓冲区里没有找到答案，但你找到了通往答案的门。"
	quest.1000000000000168.title: "回到表层"
	quest.1000000000000169.quest_desc: [
		"目标：完成本支线中的长期统计指标。"
		"教学：支线不限制主线进度，按自己的节奏推进。"
		"所有统计都基于原版统计数据，不会因为死亡清零（除非你自己清）。"
	]
	quest.1000000000000169.quest_subtitle: "归零之后没有人再记账了。但重建者必须记——\n因为你迟早要回答一个问题：这些年，你到底做了什么。"
	quest.1000000000000169.title: "重建者的账本"
	quest.100000000000016A.quest_desc: [
		"目标：集齐三份记录。"
		"教学：主世界三号实验室 / 下界要塞 / 末地观测站各一份。"
		"三份互相矛盾的地方，才是真相所在。"
	]
	quest.100000000000016A.quest_subtitle: "事件发生时只有 1.7 秒。理论上，任何在场的设备都有一份记录。\n主世界、炉心、缓冲区——三份拼起来，就是那 1.7 秒。"
	quest.100000000000016A.title: "三份记录"
	quest.100000000000016B.quest_desc: [
		"目标：找到并进入三号实验室。"
		"教学：管制区内的自动化设施，门禁卡散落在各处。"
		"里面的 Create 生产线可以拆回据点复用。"
	]
	quest.100000000000016B.quest_subtitle: "事件后仍在运转的自动化设施，里面没有人在。\n机器还在执行最后一条指令，只是收件人已经不存在了。"
	quest.100000000000016B.title: "三号实验室"
	quest.100000000000016C.quest_desc: [
		"目标：抵达零号区。"
		"教学：这是本包最深的区域，敌人为 6 星装备等级。"
		"把据点的事交代好，带上能打穿一切的东西。"
	]
	quest.100000000000016C.quest_subtitle: "所有指向零点的仪器都在同一瞬间失效了。\n所以你只能靠走——往里走，越走越不像人待的地方。"
	quest.100000000000016C.title: "零号区"
	quest.100000000000016D.quest_desc: [
		"目标：击杀赛博凋灵（CyberWither）。"
		"教学：BOSS 会 EMP 与飞行。常规枪械效率极低——RPG-7 是唯一稳妥手段。"
		"护甲与义体是活下去的前提。"
	]
	quest.100000000000016D.quest_subtitle: "零点计划把最后一台原型机留在了这里。它还在按旧协议清除「未归档对象」。"
	quest.100000000000016D.title: "赛博凋灵"
	quest.100000000000016E.quest_desc: [
		"目标：击杀归零者首领。"
		"教学：终局 BOSS 战，建议多人组队。"
		"掉落死亡之心（ZoNiEx）与终局材料。"
	]
	quest.100000000000016E.quest_subtitle: "它不是人，也不再是机器。它是归零那天被重置后又匆忙重组的东西。"
	quest.100000000000016E.title: "归零者首领"
	quest.100000000000016F.quest_desc: [
		"目标：完成终局，做出你的选择。"
		"教学：三条结局线——真相 / 封存 / 取代。"
		"无论选哪条，这座废墟都会记得你做过什么。"
	]
	quest.100000000000016F.quest_subtitle: "世界归零了。现在轮到你把准星归零。\n知道了那 1.7 秒之后，你要决定：揭开、封存，还是成为新的零点。"
	quest.100000000000016F.title: "把准星归零"
	quest.1000000000000170.quest_desc: [
		"目标：与村民交易 100 次。"
		"教学：Numismatic 提供零币；ShippingBin 可批量卖出。"
		"村民只收本职业相关的东西，价格比收购箱高。"
	]
	quest.1000000000000170.quest_subtitle: "聚落是唯一还认零币的地方。跟他们交易，等于承认「秩序」还没死透。"
	quest.1000000000000170.title: "与活人做生意"
	quest.1000000000000171.quest_desc: [
		"目标：完成本支线中的长期统计指标。"
		"教学：支线不限制主线进度，按自己的节奏推进。"
		"所有统计都基于原版统计数据，不会因为死亡清零（除非你自己清）。"
	]
	quest.1000000000000171.quest_subtitle: "归零之后没有人再记账了。但重建者必须记——\n因为你迟早要回答一个问题：这些年，你到底做了什么。"
	quest.1000000000000171.title: "重建者的账本"
	quest.1000000000000172.quest_desc: [
		"目标：累计行走 20 公里（2,000,000 cm）。"
		"教学：小地图（Xaero）不替代双腿——未探索过的区域不会显示物资。"
	]
	quest.1000000000000172.quest_subtitle: "地图上的每一格，都是你自己走过去才知道的。"
	quest.1000000000000172.title: "用脚量过的地方"
	quest.1000000000000173.quest_desc: ["目标：累计疾跑 30 公里（3,000,000 cm）。"]
	quest.1000000000000173.quest_subtitle: "在废土上，能跑的人活得比能打的人久。"
	quest.1000000000000173.title: "跑起来"
	quest.1000000000000174.quest_desc: ["目标：累计击杀 500 个敌对生物。"]
	quest.1000000000000174.quest_subtitle: "归零者、拾荒团、变异体——它们都想让你停下来。\n而你还在走。"
	quest.1000000000000174.title: "五百个"
	quest.1000000000000175.quest_desc: [
		"目标：累计承受 5000 点伤害。"
		"教学：这条不是鼓励你挨打——是记录你确实在做事。"
	]
	quest.1000000000000175.quest_subtitle: "有些伤会留在统计里，有些会留在记忆里。"
	quest.1000000000000175.title: "账面上的伤"
	quest.1000000000000176.quest_desc: ["目标：累计造成 20000 点伤害。"]
	quest.1000000000000176.quest_subtitle: "每一发子弹都是一次决定。你打出去的每一发，账本都记着。"
	quest.1000000000000176.title: "打出去的东西"
	quest.1000000000000177.quest_desc: [
		"目标：累计睡眠 50 次。"
		"教学：睡觉会重置夜潮刷怪（UndeadNights），也是刷怪高峰的分界。"
	]
	quest.1000000000000177.quest_subtitle: "有床可睡的人，才有资格谈明天。"
	quest.1000000000000177.title: "睡过的夜"
	quest.1000000000000178.quest_desc: [
		"目标：与村民交易 100 次。"
		"教学：Numismatic 提供零币；ShippingBin 可批量卖出。"
		"村民只收本职业相关的东西，价格比收购箱高。"
	]
	quest.1000000000000178.quest_subtitle: "聚落是唯一还认零币的地方。跟他们交易，等于承认「秩序」还没死透。"
	quest.1000000000000178.title: "与活人做生意"
	quest.1000000000000179.quest_desc: ["目标：累计游玩 50 小时（3,600,000 ticks）。"]
	quest.1000000000000179.quest_subtitle: "在这个世界里，活得久就是最强的成就。"
	quest.1000000000000179.title: "时间本身"
	quest.100000000000017A.quest_desc: ["目标：确认完成收集支线。"]
	quest.100000000000017A.quest_subtitle: "你整理出了一整面墙的东西。\n在归零后的世界里，这面墙本身就是一份证词。"
	quest.100000000000017A.title: "收藏家"
	quest.100000000000017B.quest_desc: [
		"目标：完成本支线的收集清单。"
		"教学：收集类任务不限制主线进度，可以随时回头补。"
	]
	quest.100000000000017B.quest_subtitle: "废墟里的一切都是别人的遗物。你捡起它们，它们就变成了你的历史。"
	quest.100000000000017B.title: "捡起来的东西"
	quest.100000000000017C.quest_desc: [
		"目标：集齐 6 种蓝图数据芯片。"
		"教学：SBW 蓝图数据芯片分 common / rare / epic / legendary / superb / virtual 六档。"
	]
	quest.100000000000017C.quest_subtitle: "军阀把工艺封进了数据卡。六档，六种权限。"
	quest.100000000000017C.title: "六档芯片"
	quest.100000000000017D.quest_desc: ["目标：集齐 5 把不同的 SBW 枪械。"]
	quest.100000000000017D.quest_subtitle: "有人收藏邮票，有人收藏酒。在这里，你收藏的是能杀死你的东西。"
	quest.100000000000017D.title: "五把枪"
	quest.100000000000017E.quest_desc: [
		"目标：收集 20 枚士兵狗牌。"
		"教学：狗牌来自军事据点与联邦残部尸体。"
	]
	quest.100000000000017E.quest_subtitle: "每一枚狗牌后面是一个人。他们没能走完，但他们的编号还在。"
	quest.100000000000017E.title: "狗牌"
	quest.100000000000017F.quest_desc: [
		"目标：收集 4 件叙事遗物（戒指 / 银行卡 / 末影之眼 / 前照灯）。"
		"教学：这些是最不出实用价值、也最能说明这个世界的物品。"
	]
	quest.100000000000017F.quest_subtitle: "戒指、银行卡、照片——这些东西在归零那天失去了用途，却没有失去重量。"
	quest.100000000000017F.title: "归零前的私人史"
	quest.1000000000000180.quest_desc: [
		"目标：收集 12 件不同的 CyberWare 元件。"
		"教学：元件是义体手术的耗材。零件越全，能装的义体越多。"
	]
	quest.1000000000000180.quest_subtitle: "义体不是买来的，是攒出来的。每一个元件都来自某个人的身体。"
	quest.1000000000000180.title: "铬教的备件箱"
	quest.1000000000000181.quest_desc: [
		"目标：囤积 8 种不同的食物各 16 份。"
		"教学：食物多样性会触发 Spice of Life 的增益。"
	]
	quest.1000000000000181.quest_subtitle: "农业模组让食物变得便宜，但「便宜」不等于「不重要」。"
	quest.1000000000000181.title: "粮仓"
	quest.1000000000000182.quest_desc: ["目标：确认完成收集支线。"]
	quest.1000000000000182.quest_subtitle: "你整理出了一整面墙的东西。\n在归零后的世界里，这面墙本身就是一份证词。"
	quest.1000000000000182.title: "收藏家"
	quest.1000000000000183.quest_desc: [
		"目标：开始长期建设计划。"
		"教学：本支线衡量「文明恢复程度」，不看击杀数。"
	]
	quest.1000000000000183.quest_subtitle: "你不是幸存者，你是重建者。\n重建的意思是：让这个世界比昨天更像一个文明。"
	quest.1000000000000183.title: "重建不是口号"
	quest.1000000000000184.quest_desc: [
		"目标：进入经济体系。"
		"教学：Numismatic 提供零币；ShippingBin 收购；MCphone 可邮购。"
		"零币也能熔成材料——攒着买枪，还是熔了做弹药，是核心抉择。"
	]
	quest.1000000000000184.quest_subtitle: "零币不是金子，也不是银子。它只是一种约定——\n但它把「抢」重新变回了「换」。"
	quest.1000000000000184.title: "所有人都承认的东西"
	quest.1000000000000185.quest_desc: [
		"目标：在收购箱卖出任意 5 次物品。"
		"教学：收购箱价格是基准价 × 0.60，但什么都收。"
		"村民价格更高，但只收本职业相关。"
	]
	quest.1000000000000185.quest_subtitle: "把捡来的东西换成钱，是把「偶然」变成「可持续」。"
	quest.1000000000000185.title: "第一次卖出"
	quest.1000000000000186.quest_desc: ["目标：持有 1000 枚零币。"]
	quest.1000000000000186.quest_subtitle: "一千零币在归零后大概等于：一把能用的步枪，或者三百发子弹。"
	quest.1000000000000186.title: "攒够一千"
	quest.1000000000000187.quest_desc: [
		"目标：通过 MCphone 的零点购物下单一次。"
		"教学：需要绑定 Contact 信箱。下单后次日（游戏日）送达。"
		"供应商价格高于收购箱，但低于村民零售。"
	]
	quest.1000000000000187.quest_subtitle: "有些东西不用亲自去废墟里翻——只要你出得起价，明天就有人送到信箱。"
	quest.1000000000000187.title: "邮购"
	quest.1000000000000188.quest_desc: ["目标：用 BountyCraft 发布并完成一次赏金任务。"]
	quest.1000000000000188.quest_subtitle: "零币的另一个用途：让别人替你做你不想做的事。"
	quest.1000000000000188.title: "发一笔赏金"
	quest.1000000000000189.quest_desc: ["目标：确认完成经济支线。"]
	quest.1000000000000189.quest_subtitle: "你的账本开始有结余了。\n这意味着你不再只靠运气活着——你有了选择。"
	quest.1000000000000189.title: "有钱的重建者"
	quest.100000000000018B.quest_desc: [
		"目标：开始长期建设计划。"
		"教学：本支线衡量「文明恢复程度」，不看击杀数。"
	]
	quest.100000000000018B.quest_subtitle: "你不是幸存者，你是重建者。\n重建的意思是：让这个世界比昨天更像一个文明。"
	quest.100000000000018B.title: "重建不是口号"
	quest.100000000000018C.quest_desc: [
		"目标：建造无线电塔（Radio Beacon）。"
		"教学：CyberWare 的无线电塔组件需要充电与元件。建成后可作远征通讯节点。"
	]
	quest.100000000000018C.quest_subtitle: "归零之后，无线电里只剩下底噪。\n你架起天线的那一刻，底噪里第一次有了别的东西。"
	quest.100000000000018C.title: "把信号发出去"
	quest.100000000000018D.quest_desc: [
		"目标：据点内常驻至少 8 名 NPC（MCA 村民 / 女仆 / 守卫）。"
		"教学：MCA 村民可招募与分配工作；Guard Villagers 会主动防御。"
	]
	quest.100000000000018D.quest_subtitle: "先是一个人，然后是一家。聚落不是建出来的，是被人聚起来的。"
	quest.100000000000018D.title: "有人来了"
	quest.100000000000018E.quest_desc: [
		"目标：库存中同时持有 4 种口径弹药各 100 发以上。"
		"教学：9mm / 5.56 / 7.62×39 / .308 覆盖了从人到变异体的全部需求。"
	]
	quest.100000000000018E.quest_subtitle: "满口径的量产弹药，意味着你终于不用看别人脸色吃饭。"
	quest.100000000000018E.title: "不再靠捡"
	quest.100000000000018F.quest_desc: ["目标：建成网络化仓库（Sophisticated Storage 控制器 + 至少 8 个箱柜）。"]
	quest.100000000000018F.quest_subtitle: "一个人搬不动的文明，交给机器搬。"
	quest.100000000000018F.title: "仓库自动化"
	quest.1000000000000190.quest_desc: [
		"目标：度过一个完整的冬天，且没有因为失温死亡。"
		"教学：暖源、衣物保暖等级、热食。LSO 的体温系统在夜里尤其致命。"
	]
	quest.1000000000000190.quest_subtitle: "季节会变（EclipticSeasons）。第一个冬天会淘汰掉一大批人。"
	quest.1000000000000190.title: "过冬"
	quest.1000000000000191.quest_desc: ["目标：确认完成重建支线。"]
	quest.1000000000000191.quest_subtitle: "你有了信号塔、有了人、有了产线、有了仓库。\n这个世界比昨天更像一个文明了。"
	quest.1000000000000191.title: "重建者"
}
